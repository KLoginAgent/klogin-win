<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputName>KLoginAgentSetup</OutputName>
    <OutputType>Bundle</OutputType>
    <Platform>x64</Platform>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.1.0.0</ProductVersion>
    <BackendUrl Condition="'$(BackendUrl)' == ''">http://localhost:8000</BackendUrl>
    <DefineConstants>ProductVersion=$(ProductVersion)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Bundle.wxs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="KLogin.Installer.wixproj">
      <Properties>AgentPublishDir=$(AgentPublishDir);CredentialProviderDll=$(CredentialProviderDll);BackendUrl=$(BackendUrl);ProductVersion=$(ProductVersion)</Properties>
    </ProjectReference>
    <PackageReference Include="WixToolset.Bal.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>

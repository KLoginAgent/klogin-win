<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputName>KLoginAgentSetup</OutputName>
    <OutputType>Bundle</OutputType>
    <TargetExt>.exe</TargetExt>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.1.0.0</ProductVersion>
    <KLoginAgentMsi Condition="'$(KLoginAgentMsi)' == ''">bin\x64\Release\KLoginAgent.msi</KLoginAgentMsi>
    <DefineConstants>ProductVersion=$(ProductVersion);KLoginAgentMsi=$(KLoginAgentMsi)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Bundle.wxs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Bal.wixext" Version="5.0.2" />
  </ItemGroup>
  <Target Name="CollectSuggestedVisualStudioComponentIds" />
</Project>
